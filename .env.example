# Plantilla local. Sustituye las credenciales antes de iniciar Compose.
APP_NAME="Portal Posgrado Estadística UMSA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
FRONTEND_URL=
SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=
VITE_API_URL=
APP_TIMEZONE=America/La_Paz

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=portal
DB_USERNAME=portal
DB_PASSWORD=

TZ=America/La_Paz
# Local: ./files/storage. Dokploy: ../files/storage (ruta persistente del servidor).
STORAGE_PATH=./files/storage

# El sistema no envía correos actualmente. Configura SMTP solo al habilitar esa función.
MAIL_MAILER=log
